<table class="acd.ta-ReadAloud_Table acd.ta-Table">
    <tr>
        <th align="left">
            <i class="fas fa-comment"></i>
            {{label}}
        </th>
        <th width="30px">
            <a class="acd-ta-read-aloud" role="button" tabindex="0" data-mode="{{mode}}" data-narrator="{{narrator}}" data-content="{{content}}" aria-label="{{label}}">
                <i class="fas fa-message"></i>
            </a>
        </th>
    </tr>
    <tr>
        <td colspan="2" class="acd-ta-read-aloud-content">{{content}}</td>
    </tr>
</table>